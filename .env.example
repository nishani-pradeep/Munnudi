# Copy to .env.local and adjust. NEVER commit .env.local.
#
#   cp .env.example .env.local
#
# Local Postgres from docker-compose.yml (host port 5433, not 5432, so it does
# not clash with any Postgres you already run locally).
DATABASE_URL="postgresql://munnudi:munnudi_local_dev@localhost:5433/munnudi"

# Property timezone. Resolves "current month" — on a UTC server this otherwise
# resolves to the previous month for the first 5.5 hours of every month.
APP_TIMEZONE="Asia/Kolkata"
